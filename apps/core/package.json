    "uuidv7": "^1.2.1",
    "zod": "^4.0.0",
    "@getalby/sdk": "9.0.0",
    "nostr-tools": "2.26.1",
    "light-bolt11-decoder": "3.2.0"
  },
  "devDependencies": {
