# Copy to .env for local development. Never commit .env.
NODE_ENV=development
APP_BASE_URL=http://localhost:3000

# Proxies in front of core whose X-Forwarded-For is believed (1: the web app; 2: a CDN, then the web app).
TRUST_PROXY=1

# Ports
WEB_PORT=3000
CORE_PORT=4000
AGENT_PORT=4100

# Where the web app proxies /api/v1 (see apps/web/next.config.ts)
CORE_URL=http://localhost:4000
AGENT_URL=http://localhost:4100

# PostgreSQL (docker-compose.yml)
DATABASE_URL=postgres://selly:selly@localhost:5432/selly
DATABASE_DIRECT_URL=postgres://selly:selly@localhost:5432/selly

# Object storage (S3-compatible: RustFS in docker-compose, Cloudflare R2 in production)
# memory: images stay in the core process (development without the storage service). s3: the buckets below.
MEDIA_STORE=memory
S3_ENDPOINT=http://localhost:9000
# Set when browsers reach the storage at another address than core does.
S3_PRESIGN_ENDPOINT=
S3_BUCKET_PUBLIC=selly-public
S3_BUCKET_PRIVATE=selly-private
S3_ACCESS_KEY_ID=selly
S3_SECRET_ACCESS_KEY=selly-secret-key

# Secrets (dev values only)
# Encrypts wallet connections at rest. Required for INVOICE_PROVIDER=nwc. 32 random bytes, base64:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Never change it once wallets are linked: add SECRETS_KEK_V2 to rotate.
SECRETS_KEK_V1=
# Extra service tokens with fewer scopes (apps/core/src/scopes.ts), as JSON. The agent's token has every scope.
SERVICE_TOKENS=
SERVICE_TOKEN_AGENT=dev-agent-token
EVENTS_HMAC_SECRET=dev-events-secret

# Platform wallet that receives subscriptions (receive-only NWC URI). Linked on first start with INVOICE_PROVIDER=nwc;
# a linked wallet is kept, replace it with: pnpm --filter @selly/core cli wallet:link --platform
SECRETS_PLATFORM_NWC_URI=
# Optional: the platform's Lightning Address (with LUD-21 verify), used when its NWC wallet does not answer.
PLATFORM_LUD16=

# Core behaviour
# Apply packages/db/migrations at start, and load the demo shop (slug: awa-style).
MIGRATE_ON_START=true
SEED_DEMO=true
# fake: invoices are simulated in memory and cannot be paid (development only).
# nwc: invoices on each vendor's own wallet. Link one with: pnpm --filter @selly/core cli wallet:link --slug awa-style
INVOICE_PROVIDER=fake
# Relays where wallets announce a one-tap pairing (nostr+walletauth links), comma separated.
NWC_PAIRING_RELAYS=wss://relay.getalby.com/v1
# Invoices must be for this network: mainnet, testnet, signet or regtest.
LIGHTNING_NETWORK=mainnet
# BTC/EUR sources for the rate (median of those that answer).
RATE_SOURCES=kraken,coinbase
# How often core delivers its events to the agent (AGENT_URL). 0 turns delivery off.
EVENTS_DISPATCH_INTERVAL_MS=1000
# How often core asks wallets about open invoices and expires unpaid orders.
RECONCILE_INTERVAL_MS=5000
# Grace, suspension, booked plans and renewal reminders. 0 turns it off.
SUBSCRIPTION_JOB_INTERVAL_MS=300000
# Public URL of product images.
CDN_BASE_URL=http://localhost:9000/selly-public

# LLM for the agent: scripted (tests), demo (rule-based, no key) or a Claude model id such as claude-opus-5-5
LLM_PRIMARY=demo
LLM_FALLBACK=
# Claude credentials (or an `ant auth login` profile)
ANTHROPIC_API_KEY=
# OpenAI-compatible models: LLM_PRIMARY=groq:openai/gpt-oss-120b (free tier: 8,000 tokens per minute, slow),
# or LLM_PRIMARY=ollama:<model> for a local model (OLLAMA_BASE_URL, default http://localhost:11434/v1), or
# openai:<model> for another compatible API (OPENAI_BASE_URL, OPENAI_API_KEY). On Groq's free tier set
# AGENT_TURN_DEADLINE_MS=150000: the default 12 s is shorter than its rate-limit waits.
GROQ_API_KEY=
GROQ_BASE_URL=
OLLAMA_BASE_URL=
OPENAI_BASE_URL=
OPENAI_API_KEY=

# Agent (apps/agent/README.md)
# Empty: the real core at CORE_URL (its internal API and demo shop awa-style).
# fake: an in-memory core, for agent work without core (dev cookie: selly_session=dev-vendor-session).
AGENT_CORE_MODE=
# Empty: PostgreSQL at DATABASE_URL (core applies the migrations). memory: no database.
AGENT_STORE=
# Public base URL of uploaded images, for product extraction from photos
MEDIA_BASE_URL=
# Speech to text for customer voice notes (apps/agent/src/asr): an HTTP service, measured first
# with `pnpm --filter @selly/agent asr-eval`. Empty: the agent asks for a written message.
ASR_URL=
ASR_API_KEY=
# Claude effort for chat replies: low (default, fastest), medium or high
LLM_EFFORT=

# Web Push alerts. Generate a pair with: npx web-push generate-vapid-keys
# The web app needs the same public key to subscribe browsers.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@selly.example
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# Nostr direct-message alerts (NIP-17) for Pro and Business: the platform's key (64 hex) and relays.
SECRETS_PLATFORM_NOSTR_KEY=
NOSTR_DM_RELAYS=wss://relay.damus.io,wss://nos.lol,wss://relay.primal.net
