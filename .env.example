# Copy to .env for local development. Never commit .env.
NODE_ENV=development
APP_BASE_URL=http://localhost:3000

# Ports
WEB_PORT=3000
CORE_PORT=4000
AGENT_PORT=4100

# Where the web app proxies /api/v1 (see apps/web/next.config.ts)
CORE_URL=http://localhost:4000
AGENT_URL=http://localhost:4100

# PostgreSQL (docker-compose.yml)
DATABASE_URL=postgres://selly:selly@localhost:5432/selly
DATABASE_DIRECT_URL=postgres://selly:selly@localhost:5432/selly

# Object storage (MinIO)
S3_ENDPOINT=http://localhost:9000
S3_BUCKET_PUBLIC=selly-public
S3_BUCKET_PRIVATE=selly-private
S3_ACCESS_KEY_ID=selly
S3_SECRET_ACCESS_KEY=selly-secret-key

# Secrets (dev values only)
# Encrypts wallet connections at rest. Required for INVOICE_PROVIDER=nwc. 32 random bytes, base64:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Never change it once wallets are linked: add SECRETS_KEK_V2 to rotate.
SECRETS_KEK_V1=
SERVICE_TOKEN_AGENT=dev-agent-token
EVENTS_HMAC_SECRET=dev-events-secret

# Platform wallet that receives subscriptions (receive-only NWC URI)
SECRETS_PLATFORM_NWC_URI=

# Core behaviour
# Apply packages/db/migrations at start, and load the demo shop (slug: awa-style).
MIGRATE_ON_START=true
SEED_DEMO=true
# fake: invoices are simulated in memory and cannot be paid (development only).
# nwc: invoices on each vendor's own wallet. Link one with: pnpm --filter @selly/core cli wallet:link --slug awa-style
INVOICE_PROVIDER=fake
# Invoices must be for this network: mainnet, testnet, signet or regtest.
LIGHTNING_NETWORK=mainnet
# BTC/EUR sources for the rate (median of those that answer).
RATE_SOURCES=kraken,coinbase
# How often core asks wallets about open invoices and expires unpaid orders.
RECONCILE_INTERVAL_MS=5000
# Public URL of product images.
CDN_BASE_URL=http://localhost:9000/selly-public

# LLM
LLM_PRIMARY=scripted
LLM_FALLBACK=
