{
  "name": "selly",
  "private": true,
  "version": "0.3.0",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": "\u003e=24"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "biome check .",
    "format": "biome check --write .",
    "infra:up": "docker compose up -d postgres storage storage-init relay",
    "infra:down": "docker compose down",
    "dev:testwallet": "pnpm --filter @selly/core exec tsx scripts/testwallet.mts serve",
    "testwallet": "pnpm --filter @selly/core exec tsx scripts/testwallet.mts",
    "docker:up": "docker compose up --build",
    "docker:down": "docker compose down"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "fast-check": "^4.10.2",
    "turbo": "^2.11.11",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  }
}
