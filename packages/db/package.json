  },
  "dependencies": {
    "drizzle-orm": "^0.44.0",
    "pg": "^8.13.0",
    "uuidv7": "^1.2.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@selly/config": "workspace:*",
    "@types/node": "^24",
    "@types/pg": "^8.11.0",
    "drizzle-kit": "^0.31.0"
  }
