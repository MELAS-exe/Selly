{
  "name": "@selly/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Drizzle schemas for the core and agent schemas, migrations and seed data (architecture.md section 4.3)",
  "exports": {
    ".": "./src/index.ts",
